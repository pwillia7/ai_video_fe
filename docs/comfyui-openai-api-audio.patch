+def comfy_audio_to_base64_wav(audio: dict,
+                              max_seconds: float | None = None,
+                              sample_rate: int = 16000,
+                              ) -> str:
+    # ComfyUI AUDIO is {"waveform": [batch, channels, samples], "sample_rate": int}
+    waveform = audio["waveform"]
+    source_rate = int(audio["sample_rate"])
+    if waveform.ndim == 3:
+        waveform = waveform[0]  # the API takes one clip, not a batch
+    waveform = waveform.detach().to(device="cpu", dtype=torch.float32)
+    # Mono: a description does not need the stereo image, and stereo is twice
+    # the bytes and twice the audio tokens
+    if waveform.shape[0] > 1:
+        waveform = waveform.mean(dim=0, keepdim=True)
+    # 16 kHz is plenty for anything a model is asked to describe, and a third of
+    # the payload of 44.1 kHz
+    if sample_rate and sample_rate != source_rate:
+        waveform = torchaudio.functional.resample(waveform, source_rate, sample_rate)
+    else:
+        sample_rate = source_rate
+    if max_seconds:
+        waveform = waveform[:, :int(max_seconds * sample_rate)]
+    # 16 bit PCM, interleaved, in a WAV container
+    samples = torch.clamp(waveform, -1., 1.).mul(32767.).to(torch.int16).numpy()
+    buffer = BytesIO()
+    with wave.open(buffer, "wb") as wav:
+        wav.setnchannels(samples.shape[0])
+        wav.setsampwidth(2)
+        wav.setframerate(sample_rate)
+        wav.writeframes(samples.T.tobytes())
+    # Raw base64, with no data: URL around it, unlike the image parts above
+    return base64.b64encode(buffer.getvalue()).decode("utf-8")
+
